  "programs": [
    {
      "id": "arms-shoulders-20261016-program",
      "name": "Arms & Shoulders Priority - Legs & Abs",
      "createdAt": "2026-10-16T06:22:47.830Z",
      "updatedAt": "2026-10-16T06:22:47.830Z",
      "notes": "Intermediate recomp plan, 3 sessions weekly: Mon A / Wed B / Fri C, with rest days between. Arms and shoulders are the priority; lower-body volume is modest. Abs finish every workout: A cable crunch, B lying leg raise, C cable crunch, 2 sets each. 18 / 21 / 21 working sets. Aim for about 60 minutes using paired arm accessories; B and C may run longer depending on equipment and transitions. Warm up 5–8 minutes plus movement-specific preparation sets. Most sets: 1–2 reps in reserve. Progress when all sets reach the top of the range with clean form. Keep abs last. Review duration and recovery after 4–6 weeks. Muscle contributions are editable estimates.",
      "workouts": [
        {
          "id": "arms-shoulders-20261016-workout-0",
          "name": "A - Shoulders First + Legs & Abs",
          "notes": "Pair incline curls with overhead triceps extensions: alternate the exercises, then rest 60–90 seconds after the pair. Keep abs last; do not pair crunches with earlier exercises. Warm-up sets are additional. Keep 1–2 good reps in reserve. When all working sets reach the top of the rep range with clean form, increase the load by the smallest available increment.",
